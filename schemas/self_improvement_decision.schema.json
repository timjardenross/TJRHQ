{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Self-Improvement Decision Schema",
  "description": "Record of a decision (approval, rejection, or evidence request) on a finding",
  "type": "object",
  "required": ["decision_id", "finding_id", "decision", "timestamp"],
  "properties": {
    "decision_id": {
      "type": "string",
      "description": "Unique identifier for this decision (e.g., 'd_20260712_001')",
      "pattern": "^d_[0-9]{8}_[0-9]{3}$"
    },
    "finding_id": {
      "type": "string",
      "description": "ID of the finding being decided on",
      "pattern": "^f_[0-9]{8}_[0-9]{3}$"
    },
    "decision": {
      "type": "string",
      "enum": ["approved", "rejected", "more_evidence_requested", "deferred"],
      "description": "The decision made"
    },
    "decision_source": {
      "type": "string",
      "enum": ["human_review", "policy_rule", "automated_escalation"],
      "description": "Where the decision came from"
    },
    "decided_by": {
      "type": "string",
      "description": "Who made the decision (user, rule name, or system component)"
    },
    "reasoning": {
      "type": "string",
      "description": "Explanation for the decision"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When this decision was made"
    },
    "conditions": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Any conditions attached to the approval (e.g., 'requires_verification')"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Additional metadata"
    }
  }
}
