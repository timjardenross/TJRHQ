{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Self-Improvement Run Schema",
  "description": "Top-level schema for a self-improvement analysis run",
  "type": "object",
  "required": ["run_id", "schema_version", "timestamp", "repository_state", "findings"],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Unique run identifier (e.g., 'r_20260712_001')",
      "pattern": "^r_[0-9]{8}_[0-9]{3}$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Version of this schema (semver)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When this run started"
    },
    "duration_ms": {
      "type": "integer",
      "description": "How long the run took in milliseconds"
    },
    "mode": {
      "type": "string",
      "enum": ["interactive", "scheduled", "dry_run"],
      "description": "Whether this was an interactive or scheduled run"
    },
    "repository_state": {
      "type": "object",
      "required": ["branch", "commit", "dirty"],
      "properties": {
        "branch": {
          "type": "string",
          "description": "Current git branch"
        },
        "commit": {
          "type": "string",
          "description": "Current commit hash"
        },
        "commit_message": {
          "type": "string",
          "description": "Message of current commit"
        },
        "dirty": {
          "type": "boolean",
          "description": "Whether working tree has uncommitted changes"
        },
        "uncommitted_files": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of uncommitted files if dirty=true"
        },
        "repo_root": {
          "type": "string",
          "description": "Absolute path to repository root"
        }
      }
    },
    "evidence_window": {
      "type": "object",
      "properties": {
        "since_commit": {
          "type": "string",
          "description": "Changes since this commit"
        },
        "since_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Changes since this time"
        },
        "since_last_run": {
          "type": "boolean",
          "description": "Whether analysis is incremental since last run"
        }
      }
    },
    "evidence_collection": {
      "type": "object",
      "properties": {
        "methods_executed": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Which evidence collection methods ran"
        },
        "unavailable_sources": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Sources that were unavailable or skipped"
        },
        "collection_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {"type": "string"},
              "error": {"type": "string"}
            }
          },
          "description": "Errors encountered during collection"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "self_improvement_finding.schema.json"
      },
      "description": "Array of findings from this run"
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_findings": {
          "type": "integer",
          "description": "Total number of findings"
        },
        "by_category": {
          "type": "object",
          "additionalProperties": {"type": "integer"},
          "description": "Count of findings by category"
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {"type": "integer"},
          "description": "Count of findings by severity"
        },
        "by_automation_eligibility": {
          "type": "object",
          "additionalProperties": {"type": "integer"},
          "description": "Count of findings by automation eligibility"
        },
        "actionable_count": {
          "type": "integer",
          "description": "Findings that require action"
        },
        "informational_count": {
          "type": "integer",
          "description": "Findings that are informational only"
        }
      }
    },
    "model_router_stats": {
      "type": "object",
      "description": "Statistics about Model Router calls during this run",
      "properties": {
        "analyse_calls": {
          "type": "integer",
          "description": "Number of self-improvement-analyse calls"
        },
        "critique_calls": {
          "type": "integer",
          "description": "Number of self-improvement-critique calls"
        },
        "mission_calls": {
          "type": "integer",
          "description": "Number of self-improvement-mission calls"
        },
        "total_latency_ms": {
          "type": "integer",
          "description": "Total latency across all Model Router calls"
        },
        "fallback_events": {
          "type": "integer",
          "description": "Number of times Model Router fell back"
        },
        "errors": {
          "type": "integer",
          "description": "Number of Model Router errors"
        }
      }
    },
    "operator_notes": {
      "type": "string",
      "description": "Notes from the operator running this analysis"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Additional metadata"
    }
  }
}
