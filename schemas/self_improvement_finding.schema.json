{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Self-Improvement Finding Schema",
  "description": "Structured representation of a single improvement finding from the self-improvement system",
  "type": "object",
  "required": ["finding_id", "run_id", "category", "title", "evidence", "confidence", "severity"],
  "properties": {
    "finding_id": {
      "type": "string",
      "description": "Unique identifier for this finding (e.g., 'f_20260712_001')",
      "pattern": "^f_[0-9]{8}_[0-9]{3}$"
    },
    "run_id": {
      "type": "string",
      "description": "Identifier of the run that produced this finding (e.g., 'r_20260712_001')",
      "pattern": "^r_[0-9]{8}_[0-9]{3}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "doc_drift",
        "duplicate_implementation",
        "placeholder_code",
        "dead_code",
        "missing_test",
        "config_drift",
        "stale_adr",
        "observability_gap",
        "security_gap",
        "resilience_gap",
        "router_bypass",
        "route_policy_drift",
        "silent_fallback",
        "model_catalogue_drift",
        "knowledge_health",
        "performance_gap",
        "operational_failure",
        "governance_violation",
        "automation_opportunity"
      ],
      "description": "Classification of the finding type"
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "description": "Short, human-readable summary of the finding"
    },
    "description": {
      "type": "string",
      "description": "Longer description of what was found and why it matters"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "observation"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["file_exists", "file_missing", "code_reference", "git_history", "test_result", "config_value", "service_status", "log_entry", "broken_link", "duplicate_file", "unreferenced_code", "timing_data", "model_output", "manual_inspection"],
            "description": "Category of evidence"
          },
          "location": {
            "type": "string",
            "description": "Where the evidence was found (file path, URL, test name, etc.)"
          },
          "line": {
            "type": "integer",
            "description": "Line number if applicable"
          },
          "symbol": {
            "type": "string",
            "description": "Function name, class name, variable, etc. if applicable"
          },
          "observation": {
            "type": "string",
            "description": "What was actually observed"
          },
          "collection_method": {
            "type": "string",
            "enum": ["grep", "git", "file_read", "subprocess", "http_request", "manual", "model_analysis"],
            "description": "How the evidence was collected"
          },
          "collected_at": {
            "type": "string",
            "format": "date-time",
            "description": "When this evidence was collected"
          },
          "source_timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp from the source (e.g., git commit, log entry)"
          }
        }
      },
      "description": "Array of concrete evidence supporting the finding"
    },
    "evidence_strength": {
      "type": "string",
      "enum": ["weak", "moderate", "strong", "conclusive"],
      "description": "Assessment of how conclusive the evidence is"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Model confidence in this finding (0.0-1.0)"
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"],
      "description": "Impact severity if not addressed"
    },
    "impact": {
      "type": "object",
      "properties": {
        "affected_components": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of components/files affected"
        },
        "user_facing": {
          "type": "boolean",
          "description": "Whether this affects user-visible behavior"
        },
        "security_related": {
          "type": "boolean",
          "description": "Whether this is a security concern"
        },
        "performance_related": {
          "type": "boolean",
          "description": "Whether this affects performance"
        }
      }
    },
    "root_cause_hypothesis": {
      "type": "string",
      "description": "Proposed root cause or explanation for the finding"
    },
    "proposed_action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["delete", "add", "modify", "consolidate", "document", "refactor", "test", "configure", "monitor"],
          "description": "Type of action proposed"
        },
        "scope": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Files or components that would be affected"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the proposed action"
        },
        "pseudo_code": {
          "type": "string",
          "description": "High-level pseudocode or outline of the change"
        }
      }
    },
    "expected_benefit": {
      "type": "string",
      "description": "What will improve if this action is taken"
    },
    "estimated_effort": {
      "type": "string",
      "enum": ["trivial", "low", "medium", "high", "very_high"],
      "description": "Time/complexity estimate for implementation"
    },
    "change_surface": {
      "type": "object",
      "properties": {
        "num_files": {
          "type": "integer",
          "description": "Estimated number of files to change"
        },
        "lines_affected": {
          "type": "integer",
          "description": "Estimated lines of code affected"
        },
        "scope_description": {
          "type": "string",
          "description": "Plain-language description of the change scope"
        }
      }
    },
    "reversibility": {
      "type": "string",
      "enum": ["easily_reversible", "reversible_with_effort", "difficult_to_reverse", "irreversible"],
      "description": "How easily this change could be reverted if needed"
    },
    "automation_eligibility": {
      "type": "string",
      "enum": ["auto_apply", "auto_with_verification", "needs_signoff", "needs_more_evidence", "manual_only"],
      "description": "Whether/how this finding should be automatically handled"
    },
    "approval_state": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "more_evidence_requested"],
      "default": "pending",
      "description": "Current approval status of this finding"
    },
    "approved_by": {
      "type": "string",
      "description": "Who approved this finding (human reviewer or rule)"
    },
    "approval_reason": {
      "type": "string",
      "description": "Why this was approved or rejected"
    },
    "verification_plan": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["unit_test", "integration_test", "manual_verification", "service_health_check", "diff_review"],
          "description": "How to verify the fix"
        },
        "expected_result": {
          "type": "string",
          "description": "What success looks like"
        },
        "commands_to_run": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Shell commands or test invocations"
        }
      }
    },
    "related_findings": {
      "type": "array",
      "items": {"type": "string"},
      "description": "IDs of other related findings (duplicates, dependencies, etc.)"
    },
    "status": {
      "type": "string",
      "enum": ["discovered", "analysed", "classified", "approved", "implemented", "verified", "reverted", "archived"],
      "description": "Current lifecycle status"
    },
    "implementation_result": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Whether implementation succeeded"
        },
        "commit": {
          "type": "string",
          "description": "Git commit hash if implemented"
        },
        "verification_passed": {
          "type": "boolean",
          "description": "Whether verification passed"
        },
        "error": {
          "type": "string",
          "description": "Error message if implementation failed"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this finding was created"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this finding was last updated"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata as needed",
      "additionalProperties": true
    }
  }
}
