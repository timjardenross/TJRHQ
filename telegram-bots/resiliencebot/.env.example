# Resilience Crosswalk Bot — create the bot with BotFather and put the token here.
# In production these come from Infisical folder /bots/resiliencebot instead
# (see deploy/tg-resiliencebot.service).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional explicit allowlist (comma-separated chat IDs); falls back to TELEGRAM_CHAT_ID.
TELEGRAM_ALLOWED_CHAT_IDS=
# LLM routing is shared with the platform (platform-runtime/llm.py):
# LLM_PROVIDER=auto
# MODEL_ROUTER_URL=http://127.0.0.1:8891
# Crosswalk audit log location (default data/resilience-crosswalk/audit.jsonl):
# RESILIENCE_AUDIT_LOG=
