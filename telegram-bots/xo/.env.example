# XO Bot environment variables
# Copy to .env and fill in the values before starting the bot.

# Required — Telegram
TELEGRAM_BOT_TOKEN=<your-bot-token-from-@BotFather>
TELEGRAM_CHAT_ID=<your-telegram-chat-id>

# Required — Supabase (used for all Supabase queries)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<supabase-anon-or-service-role-key>

# Required for /mission_create (MSN-0172)
# Base URL of the LCARS portal (no trailing slash).
# Without this, /mission_create will return an error message rather than failing silently.
# Example: https://your-portal.vercel.app
LCARS_PORTAL_URL=
