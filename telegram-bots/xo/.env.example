# XO Bot environment variables
# Copy to .env and fill in the values before starting the bot.

# Required — Telegram
TELEGRAM_BOT_TOKEN=<your-bot-token-from-@BotFather>
TELEGRAM_CHAT_ID=<your-telegram-chat-id>

# Required — Supabase (used for all Supabase queries)
SUPABASE_URL=https://<project-ref>.supabase.co
# Legacy path: SUPABASE_KEY is the service_role key, which bypasses RLS on
# all public tables. This bot's own code only ever touches 13 (see
# migration 0135_xo_bot_scoped_role.sql). Prefer the scoped path below —
# service_role is only used as the automatic fallback when the scoped
# credential isn't configured (see scoped_supabase.py / app.py::_get_supabase()).
SUPABASE_KEY=<service-role-key — fallback only, see xo-bot-scoped-role-implemented.md>

# Preferred — scoped `xo_bot` Postgres role (migration 0135), reused pattern
# from migration 0015_telegram_engineer_ro.sql. Set ALL THREE of these to
# switch the bot off service_role:
#   SUPABASE_ANON_KEY   — the Kong gateway apikey (a real, recognised
#                          project key; NOT a secret in the service_role
#                          sense — safe to store here, same key used
#                          client-side in any public frontend).
#   SUPABASE_JWT_SECRET — the project's legacy JWT signing secret
#                          (Supabase Dashboard → Project Settings → API →
#                          JWT Settings). Used to mint a non-expiring JWT
#                          carrying `role: xo_bot` at bot startup — no
#                          login/session needed. Treat this one as a real
#                          secret.
# If SUPABASE_JWT_SECRET is unset, a pre-minted token may be supplied
# instead via XO_BOT_SCOPED_TOKEN (not shown below — only needed if you're
# not letting the bot mint its own).
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Required for /mission_create (MSN-0172)
# Base URL of the LCARS portal (no trailing slash).
# Without this, /mission_create will return an error message rather than failing silently.
# Example: https://your-portal.vercel.app
LCARS_PORTAL_URL=

# Optional (MSN-0207C) — leave unset/0. intelligence/scheduler.py is the
# single owner of scheduled Captain's Brief jobs (morning/midday/eod/weekly).
# Set to 1 ONLY for local testing when that daemon is not running and you
# need this bot to send those briefs itself temporarily. Leaving this on in
# production alongside intelligence/scheduler.py causes duplicate Telegram
# messages (see MSN-0207B/C).
XO_SCHEDULED_BRIEFS_ENABLED=0
