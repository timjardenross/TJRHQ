# XO Bot environment variables
# Copy to .env and fill in the values before starting the bot.

# Required — Telegram
TELEGRAM_BOT_TOKEN=<your-bot-token-from-@BotFather>
TELEGRAM_CHAT_ID=<your-telegram-chat-id>

# Required — Supabase (used for all Supabase queries)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<supabase-anon-or-service-role-key>

# Required for /mission_create (MSN-0172)
# Base URL of the LCARS portal (no trailing slash).
# Without this, /mission_create will return an error message rather than failing silently.
# Example: https://your-portal.vercel.app
LCARS_PORTAL_URL=

# Optional (MSN-0207C) — leave unset/0. intelligence/scheduler.py is the
# single owner of scheduled Captain's Brief jobs (morning/midday/eod/weekly).
# Set to 1 ONLY for local testing when that daemon is not running and you
# need this bot to send those briefs itself temporarily. Leaving this on in
# production alongside intelligence/scheduler.py causes duplicate Telegram
# messages (see MSN-0207B/C).
XO_SCHEDULED_BRIEFS_ENABLED=0
