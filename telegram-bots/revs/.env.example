# REVS Bot environment variables
# Copy to .env and fill in the values before starting the bot.
# .env is gitignored at the repo root — never commit it.

# Required — Telegram
TELEGRAM_BOT_TOKEN=<from @BotFather — @tjrmindbody_bot's token>

# Required — Supabase
SUPABASE_URL=https://<project-ref>.supabase.co

# Required — scoped `revs_bot` Postgres role (migration
# 0147_revs_bot_scoped_role.sql). Unlike XO, this bot has NO service_role
# fallback (see scoped_supabase.py's docstring) — it refuses to start if
# these aren't configured or don't verify. Set ALL of:
#   SUPABASE_ANON_KEY   — the Kong gateway apikey (a real, recognised
#                          project key; not a secret in the service_role
#                          sense).
#   SUPABASE_JWT_SECRET — the project's legacy JWT signing secret
#                          (Supabase Dashboard -> Project Settings -> API
#                          -> JWT Settings). Used to mint a non-expiring
#                          JWT carrying `role: revs_bot` at startup.
#                          Treat this as a real secret.
# If SUPABASE_JWT_SECRET is unset, a pre-minted token may be supplied via
# REVS_BOT_SCOPED_TOKEN instead.
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Optional — comma-separated Telegram user ids for future admin/diagnostic
# commands. Empty is the safe default; this bot has no XO-style
# single-owner allowlist (it's public-facing by design).
REVS_ADMIN_USER_IDS=
