{
  "version": "1.0.0",
  "last_updated": "2026-07-12",
  "categories": {
    "doc_drift": {
      "description": "Documentation references deleted code or code without docs",
      "default_severity": "low",
      "evidence_required": "conclusive",
      "automation_eligibility": "auto_with_verification",
      "allowed_actions": ["update_documentation", "remove_dead_references"],
      "forbidden_actions": ["delete_code", "modify_implementation"]
    },
    "duplicate_implementation": {
      "description": "More than one file/service doing the same job",
      "default_severity": "medium",
      "evidence_required": "strong",
      "automation_eligibility": "needs_signoff",
      "allowed_actions": [],
      "reason": "Consolidation decisions require architectural judgment"
    },
    "placeholder_code": {
      "description": "TODO, FIXME, hardcoded data, stubs in production paths",
      "default_severity": "medium",
      "evidence_required": "strong",
      "automation_eligibility": "needs_signoff",
      "allowed_actions": [],
      "reason": "Removing/replacing logic is never auto-safe"
    },
    "dead_code": {
      "description": "Unreferenced files, functions with no callers",
      "default_severity": "low",
      "evidence_required": "conclusive",
      "automation_eligibility": "auto_with_verification",
      "allowed_actions": ["delete_file", "remove_function"],
      "forbidden_actions": ["modify_implementation"]
    },
    "missing_test": {
      "description": "New logic without test coverage; disabled tests",
      "default_severity": "medium",
      "evidence_required": "strong",
      "automation_eligibility": "needs_signoff",
      "allowed_actions": [],
      "reason": "Adding tests requires scope/approach review"
    },
    "config_drift": {
      "description": "Hardcoded constants, naming divergence between config and code",
      "default_severity": "low",
      "evidence_required": "moderate",
      "automation_eligibility": "needs_signoff",
      "allowed_actions": [],
      "reason": "Config changes can have unintended consequences"
    },
    "stale_adr": {
      "description": "ADR marked Proposed long after code shipped; Accepted but implementation changed",
      "default_severity": "low",
      "evidence_required": "moderate",
      "automation_eligibility": "needs_signoff",
      "allowed_actions": ["update_adr_status"],
      "forbidden_actions": ["delete_adr"],
      "reason": "History preservation; status updates need verification"
    },
    "observability_gap": {
      "description": "New service/route without status endpoint or logging",
      "default_severity": "medium",
      "evidence_required": "strong",
      "automation_eligibility": "needs_signoff",
      "allowed_actions": [],
      "reason": "Changes to running services require verification"
    },
    "security_gap": {
      "description": "Detected security concerns",
      "default_severity": "high",
      "evidence_required": "strong",
      "automation_eligibility": "needs_signoff",
      "allowed_actions": [],
      "reason": "Security fixes require expert review"
    },
    "resilience_gap": {
      "description": "Missing error handling, retry logic, or fallbacks",
      "default_severity": "medium",
      "evidence_required": "moderate",
      "automation_eligibility": "needs_signoff",
      "allowed_actions": [],
      "reason": "Resilience patterns require architectural review"
    },
    "router_bypass": {
      "description": "Code calling Ollama or cloud provider directly instead of Model Router",
      "default_severity": "high",
      "evidence_required": "conclusive",
      "automation_eligibility": "needs_signoff",
      "allowed_actions": [],
      "reason": "Router bypasses must be corrected by design review"
    },
    "route_policy_drift": {
      "description": "Declared routes not used, used routes not declared, or undocumented routes",
      "default_severity": "medium",
      "evidence_required": "strong",
      "automation_eligibility": "needs_signoff",
      "allowed_actions": ["add_route_declaration", "remove_unused_route"],
      "forbidden_actions": ["modify_route_behavior"]
    },
    "silent_fallback": {
      "description": "Fallback that doesn't expose requested vs actual model or crosses trust boundaries",
      "default_severity": "high",
      "evidence_required": "strong",
      "automation_eligibility": "needs_signoff",
      "allowed_actions": [],
      "reason": "Silent data classification boundary changes require security review"
    },
    "model_catalogue_drift": {
      "description": "Mismatch between configured, installed, preferred, and observed models",
      "default_severity": "medium",
      "evidence_required": "strong",
      "automation_eligibility": "needs_signoff",
      "allowed_actions": ["update_configuration"],
      "forbidden_actions": ["install_model", "remove_model"],
      "reason": "Model installation/removal requires infrastructure planning"
    },
    "knowledge_health": {
      "description": "Stale or incomplete knowledge base; missing context",
      "default_severity": "low",
      "evidence_required": "moderate",
      "automation_eligibility": "needs_signoff",
      "allowed_actions": ["update_knowledge", "refresh_cache"],
      "reason": "Knowledge updates can affect model behavior"
    },
    "performance_gap": {
      "description": "Detected performance regression or optimization opportunity",
      "default_severity": "low",
      "evidence_required": "moderate",
      "automation_eligibility": "needs_signoff",
      "allowed_actions": [],
      "reason": "Performance changes require validation against baselines"
    },
    "operational_failure": {
      "description": "Service degradation, error rate, or operational issue detected",
      "default_severity": "high",
      "evidence_required": "strong",
      "automation_eligibility": "needs_signoff",
      "allowed_actions": [],
      "reason": "Operational failures need manual triage"
    },
    "governance_violation": {
      "description": "Code or deployment violates stated principles, ADRs, or policies",
      "default_severity": "high",
      "evidence_required": "strong",
      "automation_eligibility": "needs_signoff",
      "allowed_actions": [],
      "reason": "Governance fixes require architectural review"
    },
    "automation_opportunity": {
      "description": "Opportunity to automate a manual process",
      "default_severity": "info",
      "evidence_required": "moderate",
      "automation_eligibility": "needs_signoff",
      "allowed_actions": [],
      "reason": "New automation requires design review and testing"
    }
  },
  "auto_remediation": {
    "enabled": true,
    "auto_apply_categories": ["doc_drift", "dead_code"],
    "auto_apply_no_verify_categories": [],
    "allowed_actions": ["update_documentation", "remove_dead_references", "delete_file", "remove_function"],
    "forbidden_actions": ["delete_code", "modify_implementation", "change_authentication", "change_permissions", "modify_database", "deploy_service", "modify_routing", "commit_to_repo", "push_to_remote"]
  },
  "thresholds": {
    "min_confidence_for_finding": 0.7,
    "min_confidence_for_auto_remediate": 0.95,
    "max_findings_per_run": 100,
    "max_auto_remediations_per_run": 5,
    "evidence_window_days": 30
  },
  "safety": {
    "fail_closed_conditions": ["repository_dirty", "model_router_unreachable", "tests_failing", "schema_validation_failed", "unknown_change_type", "evidence_missing"],
    "backup_before_remediate": true,
    "rollback_on_verify_failure": true,
    "require_explicit_delete_approval": true
  }
}
