# ============================================================
# Root .gitignore — repo had NONE until 2026-07-30. Every .env
# and .venv across this monorepo was untracked-but-not-ignored,
# one `git add -A` away from landing in this PUBLIC GitHub repo.
# ============================================================

# Secrets — any .env anywhere in the tree, all variants
.env
.env.*
!.env.example
!.env*.example

# Python virtualenvs — any depth, any name
.venv/
venv/
*/.venv/
*/venv/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Node
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS
.DS_Store
._*

# Logs / runtime artifacts
*.log
logs/
call_log.jsonl
outputs/

# Editor
.vscode/
.idea/
*.swp
