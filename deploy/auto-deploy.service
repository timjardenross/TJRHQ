[Unit]
# Pull-based auto-deploy for this VM's half of the platform (2026-09-07).
# See deploy/auto-deploy.sh's own header for the full design rationale and
# safety rules (dirty-tree abort, fast-forward-only, no push).
#
# The frontend (lcars-portal) already deploys automatically on merge via
# Vercel; nothing on this VM ever checked GitHub before this unit existed,
# so every backend fix required a manual SSH + `git pull`. This closes
# that gap on the same polling-timer pattern every other job on this VM
# already uses (see delivery-reconciler.timer) rather than exposing a new
# inbound webhook endpoint.
Description=Pull-based auto-deploy (git pull --ff-only + scoped service restarts)
After=network-online.target
Wants=network-online.target
# 2026-09-15 adversarial review: this ran every 5 minutes and failed every
# single time for 3+ days straight (dirty working tree correctly aborts the
# pull, but nothing ever told anyone) before it was noticed. See
# docs/security/2026-09-15-adversarial-review-remediation.md.
OnFailure=alert-on-failure@%n.service

[Service]
Type=oneshot
# 2026-09-15 adversarial review: ran as root end-to-end (git pull + npm
# build + systemctl restart) with no privilege scoping. Repo is now
# group-owned by `deploy` (chgrp -R, setgid dirs — root's existing access
# from the ~30 other root-run cron/systemd jobs sharing this tree is
# untouched, this is an additive group grant) and the one root-required
# step (systemctl restart) goes through deploy/scoped-restart.sh, which
# checks the unit against auto-deploy-services.conf before restarting —
# see deploy/scoped-restart.sh's own header and /etc/sudoers.d/deploy-restart.
User=deploy
Environment=AUTO_DEPLOY_SYSTEMCTL=/opt/starship-endeavour/deploy/sudo-scoped-restart.sh
WorkingDirectory=/opt/starship-endeavour
ExecStart=/opt/starship-endeavour/deploy/auto-deploy.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=auto-deploy
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
