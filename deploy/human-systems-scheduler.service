[Unit]
# USS-TJR-MSN-0375: formal supervision for platform-runtime/human_systems_
# scheduler.py --daemon. Stream 0 of this mission searched the whole repo
# (deploy/*.service, deploy/*.timer, /etc/crontab, USS-TJR-Control/tmux
# configs) and found ZERO reference to this scheduler anywhere — unlike
# intelligence-scheduler.service (deployed 2026-07-03, MSN-0207C), this
# daemon has never had a supervision unit. Its 7 jobs (morning/midday/eod/
# evening/weekly/degradation/comms_weekly) were previously invoked, if at
# all, by some undocumented mechanism this repo search could not find, or
# not running in production at all. This unit closes that gap and is the
# first thing that has ever supervised this daemon.
#
# Pilot scope (MSN-0375): --daemon now runs on pgqueuer (Postgres-native
# SKIP LOCKED queue against the existing Supabase Postgres instance, not
# APScheduler) — see human_systems_scheduler.py's _start_daemon_async().
# Requires SUPABASE_DB_URL (a direct Postgres connection string from the
# Supabase project's Database settings — NOT the supabase-py REST client
# credentials already in this env) to be present wherever run-with-
# infisical.sh sources secrets from; add it there before enabling this unit.
#
# Type=simple, matching intelligence-scheduler.service's pattern: this is a
# long-running daemon (pgqueuer's PgQueuer.run(), an asyncio event loop —
# it never exits under normal operation), not a discrete job.
Description=USS TJR Human Systems Scheduler — proactive pushes (pgqueuer pilot, MSN-0375)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/starship-endeavour
# 2026-11-03: Telegram delivery turned on. Until now this unit used the flat
# run-with-infisical.sh, whose shared namespace has no TELEGRAM_BOT_TOKEN /
# TELEGRAM_CHAT_ID (those are per-bot, in /bots/<bot> folders), so every job
# logged "delivered=False dry_run=True" (reason: no_telegram_config). It now
# starts through run-with-infisical-bot.sh capacitybot: shared secrets first,
# then the capacity bot's folder on top, so the pushes arrive from the same
# bot and chat as the capacity check-ins. Verified on the VM by comparing the
# python process's environment before/after: only HS_DISABLED_JOBS,
# TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID were added, nothing removed and no
# shared value changed (INFISICAL_TOKEN differs per start by design).
#
# HS_DISABLED_JOBS holds midday and evening: they overlap the capacity bot's
# own 13:00 and 20:00 check-ins. The scheduler registers only the other five
# jobs (morning, eod, weekly, degradation, comms_weekly). Remove a name from
# the list to turn that job back on, then restart this unit.
#
# This same configuration was first applied on the host as a drop-in,
# /etc/systemd/system/human-systems-scheduler.service.d/capacity-bot-telegram.conf.
# Once this file is installed over /etc/systemd/system/, delete that drop-in.
Environment=HS_DISABLED_JOBS=midday,evening
ExecStart=/opt/starship-endeavour/platform-runtime/run-with-infisical-bot.sh capacitybot -- /opt/starship-endeavour/platform-runtime/.venv/bin/python /opt/starship-endeavour/platform-runtime/human_systems_scheduler.py --daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=human-systems-scheduler

[Install]
WantedBy=multi-user.target
