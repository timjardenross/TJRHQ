[Unit]
# Command Operations Bus — cross-service routing and health orchestration.
# Polls Supabase and systemd state every COMMAND_BUS_INTERVAL seconds (default 300).
# Rules: executor_stuck | service_health | executor_needs_restart | new_missions
# Routes alerts to Slack + Telegram; self-heals executor when approved work is queued.
Description=Starship Command Operations Bus
After=network-online.target docker.service starfleet-backend.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/starship-endeavour
# No EnvironmentFile= on purpose: secrets and shared config come from Infisical via
# run-with-infisical-bot.sh below. The live unit used to also load /opt/starship-endeavour/.env,
# platform-runtime/.env and telegram-bot/.env; on 2026-11-05 every variable whose value differed
# between those files and Infisical was checked and the running process already used the Infisical
# value for all of them (telegram-bot/.env does not exist). Those files hold stale, conflicting
# values (e.g. EMBEDDING_PROVIDER mistral vs ollama), so do not re-add them.
ExecStart=/opt/starship-endeavour/platform-runtime/run-with-infisical-bot.sh xo -- /opt/starship-endeavour/platform-runtime/.venv/bin/python -m core.coordination.command_bus run
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
