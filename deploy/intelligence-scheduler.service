[Unit]
# USS-TJR-MSN-0207C: formal supervision for intelligence/scheduler.py — the
# single owner of scheduled Captain's Brief jobs (morning/midday/eod/weekly)
# plus the daily source collection and MSN-0207A's Knowledge Platform
# digest. Before this unit existed, this process had been confirmed running
# in production (MSN-0207B — 5+ consecutive days of on-schedule briefs in
# captains_daily_briefs) via an undocumented mechanism (no systemd/cron/
# docker unit anywhere in the repo) — almost certainly a manual nohup/tmux
# session with zero auto-restart protection. This unit closes that gap.
#
# DEPLOYED 2026-07-03. venv/env-file corrected 2026-07-08 (USS-TJR-MSN-0339
# WP-adjacent fix) against the actually-installed live unit, which had
# drifted from this file (slack-bot/.venv here vs platform-runtime/.venv
# live) — slack-bot/ no longer exists in this repo (retired per the
# XO-only Telegram bot policy), so slack-bot/.venv was never a valid target
# regardless. platform-runtime/.venv is confirmed correct: this exact unit
# has now run intelligence/scheduler.py successfully from it repeatedly
# (MSN-0339 WP1/WP2/WP3 live validation, 2026-07-08), including apscheduler
# and every other dependency the daemon needs — no longer an assumption.
#
# This is a long-running daemon (APScheduler BlockingScheduler — it never
# exits under normal operation), not a discrete job — Type=simple, not
# oneshot, matching tg-xo.service's pattern (the other long-running
# Telegram-facing daemon in this repo — confirmed live under that name,
# not xo-bot.service, which doesn't exist as a running unit) rather than
# delivery-reconciler's or capture-enrichment's oneshot+timer pattern.
Description=USS TJR Intelligence Scheduler — Captain's Brief (single owner, MSN-0207C)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/starship-endeavour
EnvironmentFile=/opt/starship-endeavour/platform-runtime/.env
ExecStart=/opt/starship-endeavour/platform-runtime/.venv/bin/python -m intelligence.scheduler
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=intelligence-scheduler

[Install]
WantedBy=multi-user.target
