[Unit]
# USS-TJR-MSN-0207C: formal supervision for intelligence/scheduler.py — the
# single owner of scheduled Captain's Brief jobs (morning/midday/eod/weekly)
# plus the daily source collection and MSN-0207A's Knowledge Platform
# digest. Before this unit existed, this process had been confirmed running
# in production (MSN-0207B — 5+ consecutive days of on-schedule briefs in
# captains_daily_briefs) via an undocumented mechanism (no systemd/cron/
# docker unit anywhere in the repo) — almost certainly a manual nohup/tmux
# session with zero auto-restart protection. This unit closes that gap.
#
# DEPLOYED 2026-07-03. venv/env-file corrected 2026-07-08 (USS-TJR-MSN-0339
# WP-adjacent fix) against the actually-installed live unit, which had
# drifted from this file (slack-bot/.venv here vs platform-runtime/.venv
# live) — slack-bot/ no longer exists in this repo (retired per the
# XO-only Telegram bot policy), so slack-bot/.venv was never a valid target
# regardless. platform-runtime/.venv is confirmed correct: this exact unit
# has now run intelligence/scheduler.py successfully from it repeatedly
# (MSN-0339 WP1/WP2/WP3 live validation, 2026-07-08), including apscheduler
# and every other dependency the daemon needs — no longer an assumption.
#
# This is a long-running daemon (APScheduler BlockingScheduler — it never
# exits under normal operation), not a discrete job — Type=simple, not
# oneshot, matching tg-xo.service's pattern (the other long-running
# Telegram-facing daemon in this repo — confirmed live under that name,
# not xo-bot.service, which doesn't exist as a running unit) rather than
# delivery-reconciler's or capture-enrichment's oneshot+timer pattern.
Description=USS TJR Intelligence Scheduler — Captain's Brief (single owner, MSN-0207C)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/starship-endeavour
# 2026-09-05: wrapped with run-with-infisical.sh, originally layered on
# top of the EnvironmentFile= below as a fallback for keys not yet in
# Infisical. USS-TJR-MSN-0371 Stream 0 closed that gap (pushed every
# missing key), so Stream 6 dropped the fallback file entirely — old line
# kept commented as rollback.
# EnvironmentFile=/opt/starship-endeavour/platform-runtime/.env
#
# 2026-09-13: switched to run-with-infisical-bot.sh xo. TELEGRAM_BOT_TOKEN/
# TELEGRAM_CHAT_ID intentionally live only in the XO bot's Infisical folder
# (per-bot secrets, XO-only Telegram policy) — run-with-infisical.sh's flat
# root namespace never had them. This module's captains_brief.py sends the
# morning/midday/eod briefs over Telegram, so it needs XO's creds the same
# way tg-xo.service does. Root cause of the 2026-09-13 silent morning-brief
# delivery failure (captains-brief: "Telegram not configured — printing to
# stdout") introduced by the Stream 6 migration above. (2026-09-15
# adversarial review: this fix was live on the host but had never been
# backported into this repo file until now -- found via a live/repo diff
# while adding the flock guard below.)
#
# 2026-09-15 adversarial review: this daemon owns cron-scheduled jobs
# (brief generation, daily source collection) inside its own in-process
# APScheduler -- that only prevents duplicate firing *within* one
# process, not across two. If a restart (Restart=always, RestartSec=10)
# starts a new instance while a prior one is still mid-shutdown, both
# briefly co-exist and can double-fire the same scheduled job (duplicate
# captains_daily_briefs rows + double LLM spend; intelligence_events
# dedup is content-hash-based so that side is partially, not fully,
# protected). Wrapping ExecStart in `flock -n` held for the process's
# whole lifetime (not just at start) means a second instance that can't
# get the lock exits immediately instead of running alongside the first
# -- Restart=always/RestartSec=10 then just retries until the lock frees.
ExecStart=/usr/bin/flock -n /run/intelligence-scheduler.lock /opt/starship-endeavour/platform-runtime/run-with-infisical-bot.sh xo -- /opt/starship-endeavour/platform-runtime/.venv/bin/python -m intelligence.scheduler
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=intelligence-scheduler

[Install]
WantedBy=multi-user.target
