[Unit]
Description=USS TJR VM Knowledge Processing bounded retry sweep
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claude
WorkingDirectory=/opt/starship-endeavour/core/infrastructure/vm-processing
# 2026-09-12 (USS-TJR-MSN-0371 Stream 4): cut over to Infisical, old
# EnvironmentFile= kept commented as rollback. See vm-processing.service
# for the User=claude / group-readable auth file note.
# EnvironmentFile=/opt/starship-endeavour/.env
ExecStart=/opt/starship-endeavour/platform-runtime/run-with-infisical.sh /opt/starship-endeavour/core/infrastructure/vm-processing/.venv/bin/python worker.py retry-all
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vm-processing-retry
