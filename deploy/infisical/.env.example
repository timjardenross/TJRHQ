# Copy to .env in this dir, fill real values, chmod 600. Never commit .env.
# ENCRYPTION_KEY: openssl rand -hex 16   (exactly 32 hex chars)
# AUTH_SECRET / POSTGRES_PASSWORD / REDIS_PASSWORD: openssl rand -base64 32
# Back up ENCRYPTION_KEY off-VM; losing it makes all stored secrets unrecoverable.
ENCRYPTION_KEY=
AUTH_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SITE_URL=
INFISICAL_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
DISABLE_SIGNUP=false
