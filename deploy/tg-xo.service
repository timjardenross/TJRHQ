[Unit]
# XO Telegram bot (@Starship_endeavour_xO_bot) — executive officer.
# See telegram-bots/xo/ + deploy/README-xo-bot.md.
#
# Superseded the old xo-bot/ (action-capable, full host/shell control)
# architecture on 2026-07-05 — that tree is now xo-bot.DEPRECATED-2026-07-05/.
# This file went stale when that happened (still described the deleted
# xo-bot/ layout) until corrected 2026-07-12 to match the live unit.
Description=Starship XO Telegram bot (new architecture)
After=network.target

[Service]
WorkingDirectory=/opt/starship-endeavour
# platform-runtime/.env first (shared provider config — EMBEDDING_PROVIDER,
# OLLAMA_*, SUPABASE_*, etc.), then xo/.env second so bot-specific values
# (TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID) win on any overlapping key —
# systemd layers EnvironmentFile in listed order, later overrides earlier.
# Without the platform-runtime line, EMBEDDING_PROVIDER was unset here and
# fell back to the code's "mistral" default (1024-dim) against a database
# schema migrated to 768-dim (Ollama nomic-embed-text) — every /advise and
# /challenge silently ran in degraded mode on a vector-dimension mismatch.
# 2026-09-12 (USS-TJR-MSN-0371 Stream 2): cut over to Infisical via the
# per-bot wrapper (root secrets + /bots/xo folder override — see the
# script's own header for why a plain run-with-infisical.sh can't do this,
# flat namespace vs. per-bot TELEGRAM_BOT_TOKEN/CHAT_ID). Old two-file
# EnvironmentFile= kept here, commented, as the rollback path.
# EnvironmentFile=-/opt/starship-endeavour/platform-runtime/.env
# EnvironmentFile=-/opt/starship-endeavour/telegram-bots/xo/.env
ExecStart=/opt/starship-endeavour/platform-runtime/run-with-infisical-bot.sh xo -- /opt/starship-endeavour/telegram-bots/xo/.venv/bin/python -m telegram_bots.xo.app
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
