[Unit]
Description=USS TJR Capture Enrichment Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/starship-endeavour
# 2026-09-12 (USS-TJR-MSN-0371 Stream 4): cut over to Infisical, old
# EnvironmentFile= kept commented as rollback.
# EnvironmentFile=/opt/starship-endeavour/platform-runtime/.env
ExecStart=/opt/starship-endeavour/platform-runtime/run-with-infisical.sh /opt/starship-endeavour/platform-runtime/.venv/bin/python /opt/starship-endeavour/core/capture/enrichment_worker.py --limit 20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=capture-enrichment
