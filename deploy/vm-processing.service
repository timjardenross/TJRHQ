[Unit]
Description=USS TJR VM Knowledge Processing Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claude
WorkingDirectory=/opt/starship-endeavour/core/infrastructure/vm-processing
# 2026-09-12 (USS-TJR-MSN-0371 Stream 4): cut over to Infisical. Runs as
# User=claude, which is why the auth file was made group-readable
# (infisical-readers) rather than staying root-only — see knowledge
# record for that decision. Old EnvironmentFile= kept commented as
# rollback.
# EnvironmentFile=/opt/starship-endeavour/.env
ExecStart=/opt/starship-endeavour/platform-runtime/run-with-infisical.sh /opt/starship-endeavour/core/infrastructure/vm-processing/.venv/bin/python worker.py run --limit 20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vm-processing
