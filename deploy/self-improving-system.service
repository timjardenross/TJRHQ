[Unit]
Description=USS TJR Self-Improving System
Documentation=file:///opt/starship-endeavour/docs/self-improvement/DECISION-REMEDIATION-WORKFLOW.md
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/starship-endeavour
Environment="PATH=/opt/starship-endeavour/scripts/self_improvement/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"

# Run full cycle: collect → analyze → classify → decide → remediate
ExecStart=/opt/starship-endeavour/scripts/self_improvement/.venv/bin/python3 /opt/starship-endeavour/scripts/self_improvement/orchestrator.py

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=self-improving-system

# Restart on failure (wait 5 min before retrying)
Restart=on-failure
RestartSec=300

# Timeout after 30 minutes
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
