<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.usstjr.knowledge-collection.plist — USS-TJR-MSN-0207A Mac Automation

  Runs deploy/launchd/run_knowledge_collection.sh on a schedule, which chains
  mac-collector (scan, export-manifest) and vm-transfer (transfer) so the
  document intake pipeline's first two stages run without a human/Claude
  invoking them by hand.

  THIS IS A LaunchAGENT, NOT A LaunchDaemon:
  - Deploy to ~/Library/LaunchAgents/ (per-user login session), never to
    /Library/LaunchDaemons/ (root, system-wide). The job needs the logged-in
    user's Keychain/SSH-agent state and mounted OneDrive/iCloud volumes,
    none of which a root LaunchDaemon reliably has access to.
  - It will only run while this user is logged in (console or screen-locked
    is fine; fully logged out is not). That's an accepted tradeoff for a
    personal, single-user automation.

  BEFORE DEPLOYING: replace every "REPLACE_WITH_..." placeholder below with
  the real absolute path for the target machine. See ../launchd/README.md
  for the full deployment procedure.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.usstjr.knowledge-collection</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>REPLACE_WITH_REPO_ROOT/deploy/launchd/run_knowledge_collection.sh</string>
    </array>

    <!-- Environment overrides consumed by run_knowledge_collection.sh's
         configuration block. REPO_ROOT is required; the venv paths default
         to REPO_ROOT/core/infrastructure/<tool>/.venv if omitted, but are
         listed explicitly here for clarity and easy override. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>USSTJR_REPO_ROOT</key>
        <string>REPLACE_WITH_REPO_ROOT</string>
        <key>USSTJR_MAC_COLLECTOR_VENV</key>
        <string>REPLACE_WITH_REPO_ROOT/core/infrastructure/mac-collector/.venv</string>
        <key>USSTJR_VM_TRANSFER_VENV</key>
        <string>REPLACE_WITH_REPO_ROOT/core/infrastructure/vm-transfer/.venv</string>
    </dict>

    <!-- Predictable, sleep/drift-safe schedule: StartCalendarInterval fires
         at each specific wall-clock time (and, if the Mac was asleep at
         that time, launchd runs it once shortly after wake) rather than
         StartInterval's "every N seconds since load," which drifts and can
         fire a backlog of missed runs back-to-back after a machine has been
         asleep for a while.

         Cadence: every 6 hours during a normal working day (08:00, 14:00,
         20:00, 02:00). Reasoning:
           - This is a personal single-user intake pipeline, not a
             latency-sensitive service — a same-day, not same-minute,
             turnaround from "file lands in OneDrive/iCloud" to "on the VM"
             is entirely sufficient.
           - The 02:00 run exists mainly so an overnight sync (e.g. a phone
             backup landing in iCloud late) is picked up before the next
             working day starts, without requiring the Mac to be awake at
             an inconvenient hour for anything more frequent.
           - Four runs/day keeps the lock-contention window (see the
             wrapper script's mkdir-lock) essentially theoretical for a
             transfer job that normally finishes in well under a minute for
             incremental (mostly-empty-manifest) runs.
           - A tighter cadence (hourly) was considered and rejected as
             unnecessary polling for a source that changes at human,
             not machine, speed. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>20</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>2</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <!-- Do not fire immediately when the agent is loaded/registered — only
         on the schedule above. Loading this plist (e.g. right after editing
         it, or at every login via launchctl's session bootstrap) should not
         itself trigger a collection run; the operator can always trigger a
         manual one-off run for testing via `launchctl start` (see README). -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Raw stdout/stderr from the job invocation itself (launchd/bash
         startup issues, e.g. "script not found" or "permission denied").
         Deliberately a separate file from the wrapper script's own
         timestamped internal log (~/Library/Logs/starship-knowledge-
         collection.log), which records the stage-by-stage narrative — this
         file is the fallback for problems that happen before or outside
         that logging even starts. Both live in ~/Library/Logs/ for a
         single place to look. -->
    <key>StandardOutPath</key>
    <string>/Users/REPLACE_WITH_USERNAME/Library/Logs/starship-knowledge-collection.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/REPLACE_WITH_USERNAME/Library/Logs/starship-knowledge-collection.launchd.log</string>

    <!-- Keep launchd's own working directory sane; the script itself cd's
         into each tool's directory as needed. -->
    <key>WorkingDirectory</key>
    <string>REPLACE_WITH_REPO_ROOT</string>

    <!-- Don't restart on crash/non-zero exit — a failed run should wait for
         the next scheduled slot (or a manual retry) rather than hammer a
         possibly-broken SSH/network state in a tight restart loop. -->
    <key>KeepAlive</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
