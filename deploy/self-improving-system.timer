[Unit]
Description=USS TJR Self-Improving System Timer
Documentation=file:///opt/starship-endeavour/docs/self-improvement/DECISION-REMEDIATION-WORKFLOW.md
Requires=self-improving-system.service

[Timer]
# Run daily at 07:00 Melbourne local time (host TZ set to
# Australia/Melbourne 2026-07-18). No explicit TZ suffix -> follows system
# localtime, so this tracks AEST/AEDT across DST automatically.
OnCalendar=*-*-* 07:00:00
# Also run on system startup if missed
Persistent=true
# Randomize by up to 5 minutes to avoid thundering herd
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
