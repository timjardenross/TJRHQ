[Unit]
# Starship Endeavour Model Router — on-call Ollama crew dispatcher.
# Routes classify/summarise/brief/xo-response/embed tasks to local Ollama
# with explicit keep_alive values. No model stays loaded all day.
#
# Endpoints: POST /api/model/* — see core/model-router/app.py
# Port: 8891 (localhost only)
Description=Starship Endeavour Model Router (on-call Ollama crew)
After=network.target ollama.service

[Service]
WorkingDirectory=/opt/starship-endeavour/core/model-router
Environment="MODEL_ROUTER_PORT=8891"
Environment="MODEL_ROUTER_HOST=127.0.0.1"
Environment="OLLAMA_BASE_URL=http://localhost:11434"
# Guardrails' gemma3:4b self-check (core/security/_llmsec_worker.py) is
# CPU-only inference; under normal VM load a warm call still took 37-83s
# live (2026-09-18, load avg ~9.5/8 cores). Default 45s
# (LLM_GUARDRAILS_TIMEOUT_S) was causing hard 500s on every cloud-bound
# task (self-improvement-analyse, intelligence-brief, ...). See
# core/security/llm_guardrails.py for the env var this feeds.
Environment="LLM_GUARDRAILS_TIMEOUT_S=120"
# 2026-09-12 (USS-TJR-MSN-0371 Stream 3): repo was drifted from live (was
# slack-bot/.env, a file that doesn't exist; live had already been
# corrected to platform-runtime/.env). Reconciled, then cut over to
# Infisical the same pass — old line kept commented as rollback.
# EnvironmentFile=-/opt/starship-endeavour/platform-runtime/.env
ExecStart=/opt/starship-endeavour/platform-runtime/run-with-infisical.sh /usr/bin/python3 /opt/starship-endeavour/core/model-router/app.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
