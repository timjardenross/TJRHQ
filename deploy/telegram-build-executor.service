[Unit]
# Privileged executor that codes APPROVED Telegram build requests (review-only:
# draft PR / patch artifact, nothing merged). Pairs with the read-only Telegram
# agent (telegram-chief-engineer.service) which only logs approval markers.
# See core/coordination/telegram_build_executor.py.
Description=Starship Endeavour Telegram approved-build executor
After=network.target

[Service]
# Repo root so `python -m core.coordination.telegram_build_executor` resolves.
WorkingDirectory=/opt/starship-endeavour
# Runs in platform-runtime venv; reads secrets from .env files for Slack/Telegram
# engineering path, plus the Telegram bot token for notifications. The worker
# also self-loads these in _load_env(), so order/optional (-) is safe.
EnvironmentFile=-/opt/starship-endeavour/.env
EnvironmentFile=-/opt/starship-endeavour/telegram-bot/.env
ExecStart=/opt/starship-endeavour/platform-runtime/.venv/bin/python -m core.coordination.telegram_build_executor loop --interval 90
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
