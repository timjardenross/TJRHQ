[Unit]
Description=Failure alert for %i

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/starship-endeavour
ExecStart=/opt/starship-endeavour/platform-runtime/run-with-infisical-bot.sh xo -- /usr/bin/python3 /opt/starship-endeavour/tools/alert_on_systemd_failure.py %i
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alert-on-failure
