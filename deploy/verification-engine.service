[Unit]
# STARSHIP-REDESIGN.md §4: reads every domain's heartbeat state, computes
# sure/unsure, writes one verification_state row, self-heartbeats. See
# core/platform/verification_engine.py for the full design rationale.
Description=Starship verification engine (heartbeat -> sure/unsure pass)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/starship-endeavour
# 2026-09-12 (USS-TJR-MSN-0371 Stream 1 pilot): cut over to Infisical via
# run-with-infisical.sh. Old EnvironmentFile= kept here, commented, as the
# rollback path — revert this file + daemon-reload + restart to go back.
# EnvironmentFile=/opt/starship-endeavour/platform-runtime/.env
ExecStart=/bin/sh -c '/opt/starship-endeavour/platform-runtime/run-with-infisical.sh /opt/starship-endeavour/platform-runtime/.venv/bin/python -m core.platform.verification_engine >> /opt/starship-endeavour/outputs/verification_engine.log 2>&1'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=verification-engine
