# Control Engine — environment variable template
# Copy to .env and fill in your values. Never commit .env.
#
# Supabase (anon key only — RLS enforced, read-only dashboards)
# Obtain from: Supabase dashboard > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<anon-key>

# Number One output directory — where daily_brief.json is written by number_one.py
# Defaults to core/coordination in the repo root if not set.
# NUMBER_ONE_OUTPUT_DIR=/path/to/core/coordination

# Uptime Kuma — full service health monitoring (optional)
# When set, /api/dashboard/service-health will label its source as Uptime Kuma.
# Leave unset to use the interim Control Engine health source.
# UPTIME_KUMA_URL=http://localhost:3001
