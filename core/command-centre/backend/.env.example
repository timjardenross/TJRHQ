# STARFLEET COMMAND CENTRE — Backend Environment Configuration
# Copy this file to .env and customize for your environment

# Server Configuration
NODE_ENV=development
PORT=5000

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:8080,http://localhost:3000

# Cache Configuration
CACHE_TTL_MISSION=30
CACHE_TTL_HEALTH=60
CACHE_TTL_AGENT=120

# Logging
LOG_LEVEL=debug

# Feature Flags
ENABLE_MOCK_DATA=true
ENABLE_CACHE_WARMUP=true
ENABLE_ERROR_FALLBACK=true

# Phase 2 Integration (Future)
# These will be populated as backends become available
MISSION_REGISTRY_URL=http://localhost:5001
NUMBER_ONE_URL=http://localhost:5002
SUPABASE_URL=
SUPABASE_KEY=
GITHUB_TOKEN=

# Development
DEBUG=true
