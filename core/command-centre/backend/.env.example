# STARFLEET COMMAND CENTRE — Backend Environment Configuration
# Copy this file to .env and customize for your environment

# Server Configuration
NODE_ENV=development
PORT=5000

# CORS Configuration
# Comma-separated list of allowed origins.
# For VPS deploys, include the production dashboard domain and any ngrok URL
# you actively rely on during migration/testing.
CORS_ORIGIN=http://localhost:8080,http://localhost:3000

# Cache Configuration
CACHE_TTL_MISSION=30
CACHE_TTL_HEALTH=60
CACHE_TTL_AGENT=120

# Logging
LOG_LEVEL=debug

# Feature Flags
ENABLE_MOCK_DATA=true
ENABLE_CACHE_WARMUP=true
ENABLE_ERROR_FALLBACK=true

# Backend API key — REQUIRED. The server refuses to start without it.
BACKEND_API_KEY=

# Internal service endpoints — env-driven so the system is VM-agnostic.
# Local dev defaults to localhost; in production set these to externally
# resolvable hostnames/IPs (NOT localhost).
MISSION_REGISTRY_URL=http://localhost:5001
NUMBER_ONE_URL=http://localhost:5002
OLLAMA_URL=http://localhost:11434

# Supabase — use the project API URL (https://<project-ref>.supabase.co),
# NOT the dashboard URL (https://supabase.com/dashboard/...).
SUPABASE_URL=
# Canonical service role key. (Legacy SUPABASE_KEY is still accepted as a fallback.)
SUPABASE_SERVICE_ROLE_KEY=
# Supabase reliability tunables (optional — sensible defaults applied if unset).
# SUPABASE_TIMEOUT_MS=8000      # per-attempt socket timeout (500–60000)
# SUPABASE_MAX_RETRIES=1        # retries after first attempt, transient errors only (0–3)
# SUPABASE_RETRY_DELAY_MS=250   # pause before a retry (0–10000)
# SUPABASE_SLOW_MS=1500         # latency above which a WARN is logged
# SUPABASE_LOG_LATENCY=true     # set "false" to silence per-request latency logs
GITHUB_TOKEN=

# Development
DEBUG=true
