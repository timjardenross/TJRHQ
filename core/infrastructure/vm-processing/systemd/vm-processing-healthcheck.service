[Unit]
Description=USS TJR VM Knowledge Processing health check
After=network-online.target
Wants=network-online.target
# healthcheck.py exits 1 when `healthy: false` — uncomment and point at a
# real alerting unit to get systemd-driven notification on top of the log:
# OnFailure=your-alerting-unit@%n.service

[Service]
Type=oneshot
User=claude
WorkingDirectory=/opt/starship-endeavour/core/infrastructure/vm-processing
EnvironmentFile=/opt/starship-endeavour/.env
ExecStart=/bin/sh -c '/opt/starship-endeavour/core/infrastructure/vm-processing/.venv/bin/python healthcheck.py >> /opt/starship-endeavour/core/infrastructure/vm-processing/logs/vm-processing-healthcheck.log 2>&1'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vm-processing-healthcheck
