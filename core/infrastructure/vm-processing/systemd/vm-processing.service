[Unit]
Description=USS TJR VM Knowledge Processing Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claude
WorkingDirectory=/opt/starship-endeavour/core/infrastructure/vm-processing
EnvironmentFile=/opt/starship-endeavour/.env
ExecStart=/opt/starship-endeavour/core/infrastructure/vm-processing/.venv/bin/python worker.py run --limit 20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vm-processing
