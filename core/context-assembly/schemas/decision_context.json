{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionContextPackage",
  "description": "Full context for a strategic decision — what was decided, why, and what it affects.",
  "type": "object",
  "properties": {
    "decision_id": { "type": "string", "description": "DEC-YYYYMMDD-... identifier" },
    "assembled_at": { "type": "string", "format": "date-time" },
    "date": { "type": "string", "format": "date" },
    "status": { "type": "string" },
    "question": { "type": "string" },
    "action": { "type": ["string", "null"] },
    "bottleneck": { "type": ["string", "null"] },
    "related_missions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "relationship": { "type": "string" }
        }
      }
    },
    "awaiting_captain_input": { "type": "boolean", "description": "True if decision is pending and needs Captain action" },
    "urgency": { "type": "string", "enum": ["high", "medium", "low", "none"] }
  },
  "required": ["decision_id", "assembled_at", "date", "status", "question"],
  "additionalProperties": false
}
