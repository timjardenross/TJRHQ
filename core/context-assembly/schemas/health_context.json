{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HealthContextPackage",
  "description": "Summary-level health context for Captain briefings. Advisory only — no clinical detail.",
  "type": "object",
  "properties": {
    "assembled_at": { "type": "string", "format": "date-time" },
    "source_file": { "type": "string", "description": "Path to Health Summary source document" },
    "status_summary": {
      "type": "object",
      "properties": {
        "pain_level": { "type": ["string", "null"], "description": "Current pain (low/moderate/high or score)" },
        "mood": { "type": ["string", "null"], "enum": ["low", "stable", "positive", null] },
        "energy": { "type": ["string", "null"], "enum": ["low", "moderate", "high", null] },
        "stress": { "type": ["string", "null"], "enum": ["low", "moderate", "high", null] },
        "sleep_quality": { "type": ["string", "null"], "enum": ["poor", "fair", "good", null] }
      },
      "additionalProperties": false
    },
    "trend_summary": {
      "type": "object",
      "properties": {
        "pain_trend": { "type": ["string", "null"], "enum": ["improving", "stable", "worsening", "unknown", null] },
        "energy_trend": { "type": ["string", "null"], "enum": ["improving", "stable", "worsening", "unknown", null] },
        "overall_direction": { "type": ["string", "null"], "enum": ["improving", "stable", "worsening", "unknown", null] }
      },
      "additionalProperties": false
    },
    "recovery_priorities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Current week recovery focus items"
    },
    "health_themes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Standing health themes (from Section 3)"
    },
    "medical_officer_note": { "type": ["string", "null"], "description": "Brief advisory note from Medical Officer context" },
    "safety_flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Any urgent symptoms or escalation indicators (empty if none)"
    },
    "workload_constraint": {
      "type": ["string", "null"],
      "enum": ["reduced", "normal", "unknown", null],
      "description": "Suggested workload level given current health status"
    },
    "data_quality": {
      "type": "string",
      "enum": ["complete", "partial", "missing"],
      "description": "Whether weekly reflection data was available"
    }
  },
  "required": ["assembled_at", "source_file", "status_summary", "trend_summary", "recovery_priorities", "data_quality"],
  "additionalProperties": false
}
