{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MissionContextPackage",
  "description": "Full context for a single mission — extends existing ContextPackage.",
  "type": "object",
  "properties": {
    "entity_id": { "type": "string" },
    "entity_type": { "type": "string", "const": "mission" },
    "assembled_at": { "type": "string", "format": "date-time" },
    "overview": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "status": { "type": "string" },
        "owner": { "type": "string" },
        "priority": { "type": "string" },
        "due_date": { "type": ["string", "null"] },
        "created": { "type": "string" },
        "source": { "type": "string" },
        "completed": { "type": "boolean" }
      }
    },
    "triggering_decisions": { "type": "array", "items": { "$ref": "#/definitions/EntityRef" } },
    "dependencies": { "type": "array", "items": { "$ref": "#/definitions/EntityRef" } },
    "dependent_missions": { "type": "array", "items": { "$ref": "#/definitions/EntityRef" } },
    "capabilities_built": { "type": "array", "items": { "$ref": "#/definitions/EntityRef" } },
    "governing_adrs": { "type": "array", "items": { "$ref": "#/definitions/EntityRef" } },
    "related_decisions": { "type": "array", "items": { "$ref": "#/definitions/EntityRef" } },
    "completeness_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "gaps": { "type": "array", "items": { "type": "string" } },
    "recommended_actions": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["entity_id", "entity_type", "assembled_at", "overview"],
  "definitions": {
    "EntityRef": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": ["string", "null"] }
      },
      "required": ["id", "type", "title"]
    }
  },
  "additionalProperties": false
}
