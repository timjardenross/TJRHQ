{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RetrievalContextPackage",
  "description": "Metadata for a retrieved item (Captain's Log entry, decision, document).",
  "type": "object",
  "properties": {
    "source_type": { "type": "string", "enum": ["captains_log", "decision", "mission", "memory_file"] },
    "source_path": { "type": "string" },
    "date": { "type": "string", "format": "date" },
    "title": { "type": ["string", "null"] },
    "excerpt": { "type": "string", "description": "Relevant text snippet" },
    "relevance_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "related_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Mission/decision IDs referenced in this item"
    }
  },
  "required": ["source_type", "source_path", "date", "excerpt"],
  "additionalProperties": false
}
