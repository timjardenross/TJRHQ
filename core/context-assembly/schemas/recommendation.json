{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recommendation",
  "description": "A single ranked recommendation from Number One / Recommendation Engine.",
  "type": "object",
  "properties": {
    "priority_rank": { "type": "integer", "minimum": 1, "maximum": 10, "description": "Rank (1 = highest priority)" },
    "mission_id": { "type": "string", "description": "MSN-XXXX identifier" },
    "title": { "type": "string" },
    "reason": { "type": "string", "description": "Human-readable rationale for this recommendation" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "deadline_urgency": { "type": "string", "enum": ["high", "medium", "low", "none"] },
    "health_constraint_note": { "type": ["string", "null"], "description": "Health consideration if relevant" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "next_action": { "type": "string" },
    "due_date": { "type": ["string", "null"], "format": "date" }
  },
  "required": ["priority_rank", "mission_id", "title", "reason", "deadline_urgency", "confidence", "next_action"],
  "additionalProperties": false
}
