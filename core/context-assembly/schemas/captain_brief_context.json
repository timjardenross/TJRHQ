{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CaptainBriefContext",
  "description": "Captain's Daily Brief — assembled situational picture for the day.",
  "type": "object",
  "properties": {
    "assembled_at": { "type": "string", "format": "date-time" },
    "date": { "type": "string", "format": "date" },
    "source": { "type": "string", "enum": ["fresh", "cached", "stale"] },
    "health": { "$ref": "health_context.json" },
    "top_priorities": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "recommendation.json" }
    },
    "blockers": {
      "type": "array",
      "items": { "$ref": "blocker_context.json" }
    },
    "decisions_awaiting_input": {
      "type": "array",
      "items": { "$ref": "decision_context.json" }
    },
    "system_health": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["green", "yellow", "red"] },
        "alert_count": { "type": "integer", "minimum": 0 },
        "active_mission_count": { "type": "integer", "minimum": 0 },
        "blocked_mission_count": { "type": "integer", "minimum": 0 }
      },
      "required": ["status", "alert_count"]
    },
    "key_dates_this_week": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "label": { "type": "string" },
          "mission_id": { "type": ["string", "null"] }
        },
        "required": ["date", "label"]
      }
    },
    "number_one_summary": { "type": ["string", "null"], "description": "One-line XO synthesis for the day" }
  },
  "required": ["assembled_at", "date", "source", "top_priorities", "blockers", "system_health"],
  "additionalProperties": false
}
