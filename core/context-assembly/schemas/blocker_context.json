{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BlockerContextPackage",
  "description": "Context for a blocked mission — what is blocked, why, and what unblocks it.",
  "type": "object",
  "properties": {
    "mission_id": { "type": "string" },
    "mission_title": { "type": "string" },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "blocked_since": { "type": ["string", "null"], "format": "date-time" },
    "blocker_age_days": { "type": "integer", "minimum": 0 },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "blocking_mission_id": { "type": ["string", "null"] },
          "severity": { "type": "string", "enum": ["critical", "high", "normal"] }
        },
        "required": ["description", "severity"]
      }
    },
    "dependent_missions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Mission IDs that are blocked downstream by this blocker"
    },
    "recommended_action": { "type": "string" },
    "escalation_level": { "type": "string", "enum": ["critical", "high", "medium", "none"] }
  },
  "required": ["mission_id", "mission_title", "priority", "blockers", "escalation_level"],
  "additionalProperties": false
}
