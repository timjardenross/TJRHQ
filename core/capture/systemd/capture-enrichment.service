[Unit]
Description=USS TJR Capture Enrichment Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/starship-endeavour
EnvironmentFile=/opt/starship-endeavour/platform-runtime/.env
ExecStart=/opt/starship-endeavour/platform-runtime/.venv/bin/python /opt/starship-endeavour/core/capture/enrichment_worker.py --limit 20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=capture-enrichment
