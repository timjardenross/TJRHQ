# USS TJR Slack Bot — environment variable reference
# Copy to .env and fill in real values

# ---------------------------------------------------------------------------
# Slack credentials
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# ---------------------------------------------------------------------------
# Scheduler: delivery
# ---------------------------------------------------------------------------
BRIEF_TIME=07:00              # 24h AEST — morning brief push time
BRIEF_CHANNEL=D...            # Slack DM channel ID (preferred) or channel ID
BRIEF_USER_ID=U...            # Captain's Slack user ID (fallback to open DM)
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# Scheduler: thresholds
# ---------------------------------------------------------------------------
STALE_MISSION_DAYS=7          # Legacy stale-mission check (days)
MISSION_OPEN_DAYS=3           # Days before OPEN mission escalates
MISSION_STALE_HOURS=48        # Hours without git activity before ALERT
PAIN_ALERT_THRESHOLD=7        # Pain score >= this triggers escalation
PAIN_ALERT_DAYS=3             # Consecutive days at threshold
APPOINTMENT_LEAD_DAYS=2       # Days ahead to detect upcoming appointments
DECISION_STALE_DAYS=7         # Days before unresolved decision/ADR escalates

# ---------------------------------------------------------------------------
# Notification controls (captain_notifications.py)
# ---------------------------------------------------------------------------
NOTIFICATION_LEVEL=WARNING    # Minimum level to push: INFO / WARNING / ALERT / CRITICAL
QUIET_HOURS_START=22          # Hour (24h AEST) — no pushes after this
QUIET_HOURS_END=7             # Hour (24h AEST) — no pushes before this
WEEKEND_NOTIFICATIONS=false   # true = push exceptions on weekends
DAILY_BRIEF_ENABLED=true
MISSION_ESCALATIONS_ENABLED=true
HEALTH_REMINDERS_ENABLED=true
FORGOTTEN_DECISIONS_ENABLED=true

# ---------------------------------------------------------------------------
# Context Assembly Service (deploy/context-service.service)
# ---------------------------------------------------------------------------
# Shared secret checked on every core/context-assembly/context_service.py
# `serve` route except /health, once this service is reachable from the
# public internet (via Caddy) rather than localhost-only. Must match
# CONTEXT_SERVICE_SECRET in lcars-portal's Vercel project env vars exactly.
# Leave unset for local dev - the check is skipped entirely when this isn't
# configured (see context_service.py's _require_secret()).
CONTEXT_SERVICE_SECRET=
