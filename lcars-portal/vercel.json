{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../config/osint_intelligence_missions.json",
  "git": {
    "deploymentEnabled": {
      "dependabot/**": false,
      "self-improvement": false,
      "claude/**": false,
      "worktree-*": false,
      "archive/**": false,
      "fix/**": false,
      "feat/**": false,
      "feature/**": false,
      "chore/**": false,
      "docs/**": false,
      "hotfix/**": false,
      "bugfix/**": false,
      "codex/**": false,
      "agent/**": false,
      "bot/**": false,
      "test/**": false,
      "tmp/**": false,
      "review/**": false,
      "wip/**": false,
      "state/**": false,
      "mistral/**": false
    }
  }
}
