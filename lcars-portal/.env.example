# Starship Endeavour LCARS Portal — environment template
#
# Phase 1 runs entirely on mock data and needs NONE of these set.
# These are provided so Phase 2 can swap mock data for live API calls
# without changing component code.

# Command Centre backend (Express, MSN-0035). Existing service — do not modify.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5050/api/v1

# Feature flag: when "true", lib/data.ts may fetch live data instead of mocks.
# Phase 1 leaves this false/unset so the portal is fully static + navigable.
NEXT_PUBLIC_USE_LIVE_DATA=false

# Canonical production origin used by sitemap.ts, robots.ts, and
# metadataBase. Vercel production deploys resolve this to
# https://tjrmindbody.com automatically (see src/lib/site.ts); only set
# this explicitly if the production domain changes.
NEXT_PUBLIC_SITE_URL=https://tjrmindbody.com
