[Unit]
Description=USS TJR Self-Improving Loop Timer
Documentation=file:///root/USSTJROS/docs/self-improvement/OPERATIONS.md

[Timer]
# Run twice weekly: Tuesday and Friday at 09:00 UTC
OnCalendar=Tue *-*-* 09:00:00 UTC
OnCalendar=Fri *-*-* 09:00:00 UTC

# Run immediately if missed (e.g., system was down)
Persistent=true

# Accuracy: at least within 1 minute
AccuracySec=1min

# Unit to run
Unit=self-improving-loop.service

[Install]
WantedBy=timers.target
