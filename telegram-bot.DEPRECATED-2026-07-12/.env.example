# Telegram Chief Engineer agent — example env. Copy to .env and fill in.

# --- Telegram (required to run) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
# Comma/space separated chat ids allowed to talk to the agent.
# Empty == nobody allowed (closed by default).
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Supabase ---
# SUPABASE_URL is inherited from the repo-root .env.
# Preferred: mint a scoped read/append token from the project's JWT secret.
SUPABASE_JWT_SECRET=
# Alternative: paste a pre-minted restricted token instead of the secret.
TELEGRAM_SUPABASE_KEY=

# --- LLM ---
# Reuses repo GEMINI_API_KEY; "auto" selects Gemini when only that is set.
LLM_PROVIDER=auto
